                    <svg
                        class="tool-logo"
                        viewBox="0 0 128 128"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <rect width="128" height="128" rx="22" fill="#00ADD8"/>
                        <text x="64" y="80" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#fff" text-anchor="middle">Go</text>
                    </svg>
                    <span class="tool-name">Go</span>
                </div>

                <!-- TypeScript -->
                <div class="tool-card">
                    <svg
                        class="tool-logo"
                        viewBox="0 0 128 128"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <rect width="128" height="128" rx="22" fill="#3178C6"/>
                        <text x="64" y="82" font-family="Arial, sans-serif" font-size="42" font-weight="bold" fill="#fff" text-anchor="middle">TS</text>
                    </svg>
                    <span class="tool-name">TypeScript</span>
                </div>

                <!-- React -->
                <div class="tool-card">
                    <svg
                        class="tool-logo"
                        viewBox="0 0 128 128"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <circle cx="64" cy="64" r="12" fill="#61DAFB"/>
                        <ellipse cx="64" cy="64" rx="58" ry="26" fill="none" stroke="#61DAFB" stroke-width="9"/>
                        <ellipse cx="64" cy="64" rx="58" ry="26" fill="none" stroke="#61DAFB" stroke-width="9" transform="rotate(60 64 64)"/>
                        <ellipse cx="64" cy="64" rx="58" ry="26" fill="none" stroke="#61DAFB" stroke-width="9" transform="rotate(120 64 64)"/>
                    </svg>
                    <span class="tool-name">React</span>
                </div>

                <!-- Gin -->
                <div class="tool-card">
                    <svg
                        class="tool-logo"
                        viewBox="0 0 128 128"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <rect width="128" height="128" rx="22" fill="#2F3947"/>
                        <text x="64" y="80" font-family="Arial, sans-serif" font-size="30" font-weight="bold" fill="#fff" text-anchor="middle">Gin</text>
                    </svg>
                    <span class="tool-name">Gin</span>
                </div>

                <!-- Node -->
                <div class="tool-card">
                    <svg
                        class="tool-logo"
                        viewBox="0 0 128 128"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <rect width="128" height="128" rx="22" fill="#339933"/>
                        <text x="64" y="76" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#fff" text-anchor="middle">Node</text>
                    </svg>
                    <span class="tool-name">Node</span>
                </div>
            </div>
        </div>

        <!-- Columna derecha: Ingeniería -->
        <div class="skills-column">
            <h3
                class="column-title"
                data-es="Ingeniería de Software"
                data-en="Software Engineering"
            >
                Ingeniería de Software
            </h3>
            <div class="engineering-list">
                {
                    engineeringSkills.map((skill) => (
                        <div class="eng-card">
                            <div class="eng-text">
                                <strong
                                    data-es={skill.name.es}
                                    data-en={skill.name.en}
                                >
                                    {skill.name.es}
                                </strong>
                                <p
                                    data-es={skill.desc.es}
                                    data-en={skill.desc.en}
                                >
                                    {skill.desc.es}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .skills {
        padding: 80px 0;
        background: transparent;
        border-radius: var(--md-sys-shape-extra-large);
        margin: 0 auto 40px;
        max-width: 960px;
    }

    .skills-header {
        text-align: center;
        margin-bottom: 70px;
    }

    .skills-header h2 {
        margin-bottom: 16px;
        font: var(--md-sys-typescale-display-small);
        font-weight: 700;
        background: linear-gradient(
            90deg,
            var(--accent-green),
            var(--accent-purple)
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .skills-header p {
        font: var(--md-sys-typescale-body-large);
        color: var(--text-secondary);
        max-width: 620px;
        margin: 0 auto;
        line-height: 1.7;
    }

    .skills-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: stretch;
    }

    .skills-column {
        display: flex;
        flex-direction: column;
    }

.column-title {
        font: var(--md-sys-typescale-title-small);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--accent-green);
        margin-bottom: 28px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(169, 232, 195, 0.15);
        text-align: center;
    }

    /* ── Herramientas ── */
    .tools-list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(4, 1fr);
        gap: 12px;
        flex: 1;
    }

    .tool-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: var(--md-sys-color-surface-container-high);
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: var(--md-sys-shape-lg);
        padding: 20px 12px;
        transition: var(--transition);
        cursor: default;
        text-align: center;
    }

    .tool-card:hover {
        background: var(--md-sys-color-surface-container-highest);
        border-color: var(--accent-green);
        transform: translateY(-4px);
        box-shadow: var(--md-sys-elevation-2);
    }

    .tool-logo {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
    }

    .tool-name {
        font: var(--md-sys-typescale-body-medium);
        color: var(--text-primary);
        line-height: 1.2;
    }

    /* ── Ingeniería ── */
    .engineering-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex: 1;
    }

    .eng-card {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        background: var(--md-sys-color-surface-container);
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: var(--md-sys-shape-lg);
        padding: 18px 20px;
        transition: var(--transition);
        flex: 1;
    }

    .eng-card:hover {
        background: var(--md-sys-color-surface-container-high);
        border-color: var(--accent-green);
        transform: translateX(6px);
    }

    .eng-text strong {
        display: block;
        font-size: 0.98rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 4px;
    }

    .eng-text p {
        font-size: 0.85rem;
        color: var(--text-secondary);
        line-height: 1.55;
        margin: 0;
    }

    /* ── Responsive ── */
    @media (max-width: 900px) {
        .skills {
            padding: 80px 20px;
        }
        .skills-grid {
            grid-template-columns: 1fr;
            gap: 48px;
        }
        .tools-list {
            grid-template-rows: unset;
        }
    }

    @media (max-width: 480px) {
        .tools-list {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
