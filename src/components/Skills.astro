                            <stop offset="1" stop-color="#306998"></stop>
                        </linearGradient>
                        <linearGradient
                            id="py-b"
                            x1="209.474"
                            x2="173.62"
                            y1="1098.811"
                            y2="1149.537"
                            gradientTransform="matrix(.563 0 0 -.568 -29.215 707.817)"
                            gradientUnits="userSpaceOnUse"
                        >
                            <stop offset="0" stop-color="#FFD43B"></stop>
                            <stop offset="1" stop-color="#FFE873"></stop>
                        </linearGradient>
