                        ></path>
                    </svg>
                    <span class="tool-name">Python</span>
                </div>

                <!-- FastAPI -->
                <div class="tool-card">
                    <svg
                        class="tool-logo"
                        viewBox="0 0 128 128"
                        xmlns="http://www.w3.org/2000/svg"
