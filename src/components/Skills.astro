                    <svg
                        class="tool-logo"
                        viewBox="0 0 128 128"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <rect width="128" height="128" rx="20" fill="#46e3b7"/>
                        <path fill="#0b0d0e" d="M64 28c-19.33 0-35 15.67-35 35s15.67 35 35 35 35-15.67 35-35-15.67-35-35-35zm0 6c16.02 0 29 12.98 29 29S80.02 92 64 92 35 79.02 35 63s12.98-29 29-29z"/>
