---
const github = "https://github.com/FernandezMarcodev";
const linkedin =
  "https://www.linkedin.com/in/marco-valentin-fernandez-741222352/";
---

<section id="hero" class="hero reveal">
  <div class="hero-content">
    <div class="hero-text">
      <div class="badge-container">
        <span
          class="badge"
          data-es="Disponible para nuevos proyectos"
          data-en="Available for new projects"
          >Disponible para nuevos proyectos</span
        >
      </div>
      <h1 class="hero-title">Marco Valentín Fernández</h1>
      <h2
        class="hero-subtitle"
        data-es="Desarrollador Backend"
        data-en="Backend Developer"
      >
        Desarrollador Backend
      </h2>
      <p
        class="tagline"
        data-es="Analista en Informática recibido de la Universidad Nacional del Oeste (UNO) y estudiante de la Licenciatura en Informática. Enfoque en robustez, escalabilidad y calidad de software."
        data-en="Computer Systems Analyst graduate from Universidad Nacional del Oeste (UNO) and Computer Science student. Focused on robustness, scalability, and software quality."
      >
        Analista en Informática recibido de la Universidad Nacional del Oeste (UNO) y estudiante de la Licenciatura en Informática. Enfoque en robustez, escalabilidad y calidad de software.
      </p>

      <div class="about-bio">
        <p
          data-es="Mi pasión es crear sistemas backend robustos y escalables, con un enfoque constante en la calidad, la eficiencia y las buenas prácticas de ingeniería."
          data-en="My passion is building robust and scalable backend systems, with a constant focus on quality, efficiency, and good engineering practices."
        >
          Mi pasión es crear sistemas backend robustos y escalables, con un enfoque constante en la calidad, la eficiencia y las buenas prácticas de ingeniería.
        </p>
        <p
          data-es="Con formación en Ingeniería de Software — desde diseño de sistemas hasta despliegue y validación — disfruto convertir problemas complejos en soluciones elegantes y eficientes."
          data-en="Trained in Software Engineering — from system design to deployment and validation — I enjoy turning complex problems into elegant, efficient solutions."
        >
          Con formación en Ingeniería de Software — desde diseño de sistemas hasta despliegue y validación — disfruto convertir problemas complejos en soluciones elegantes y eficientes.
        </p>
      </div>

      <div class="hero-actions">
        <a
          href="/assets/cv.pdf"
          download
          class="btn btn-primary"
          data-es="Descargar CV"
          data-en="Download CV">Descargar CV</a
        >
        <div class="socials">
          <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={linkedin} target="_blank" rel="noopener noreferrer"
            >LinkedIn</a
          >
        </div>
      </div>

      <div class="hero-highlights">
        <div class="highlight">
          <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
          </span>
          <div class="highlight-text">
            <strong data-es="Educación" data-en="Education">Educación</strong>
            <p data-es="Analista en Informática recibido — Universidad Nacional del Oeste (UNO)" data-en="Computer Systems Analyst graduate — Universidad Nacional del Oeste (UNO)">Analista en Informática recibido — Universidad Nacional del Oeste (UNO)</p>
            <a
              href="https://www.uno.edu.ar/"
              target="_blank"
              rel="noopener noreferrer"
              class="edu-link"
              data-es="uno.edu.ar"
              data-en="uno.edu.ar"
              >uno.edu.ar</a
            >
          </div>
        </div>
        <div class="highlight">
          <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <div class="highlight-text">
            <strong data-es="Enfoque" data-en="Focus">Enfoque</strong>
            <p data-es="Backend, APIs y Calidad de Software" data-en="Backend, APIs & Software Quality">Backend, APIs y Calidad de Software</p>
          </div>
        </div>
        <div class="highlight">
          <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 013 3L7 19l-4 1 1-4z"></path>
            </svg>
          </span>
          <div class="highlight-text">
            <strong data-es="Buenas Prácticas" data-en="Best Practices">Buenas Prácticas</strong>
            <p data-es="Código limpio, testing y CI/CD" data-en="Clean code, testing & CI/CD">Código limpio, testing y CI/CD</p>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-image">
      <div class="profile-card">
        <div class="image-wrapper">
          <div class="image-glow"></div>
          <img
            src="/assets/images/perfil.jpeg"
            alt="Marco Valentín Fernández - Foto de Perfil"
          />
        </div>
        <div class="profile-card-footer">
          <strong>Marco Valentín Fernández</strong>
          <span data-es="Desarrollador Backend" data-en="Backend Developer">Desarrollador Backend</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 48px;
    position: relative;
    overflow: hidden;
  }

  .hero-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .hero-text {
    flex: 1;
  }

  .badge-container {
    margin-bottom: 24px;
  }

  .badge {
    color: var(--accent-green);
    background: rgba(107, 227, 169, 0.05);
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    border: 1px solid rgba(107, 227, 169, 0.2);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .badge::before {
    content: "";
    width: 8px;
    height: 8px;
    background: var(--accent-green);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 10px var(--accent-green);
  }

  .hero-title {
    font: var(--md-sys-typescale-display-small);
    line-height: 1.1;
    margin-bottom: 12px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .hero-subtitle {
    font: var(--md-sys-typescale-headline-medium);
    text-align: left;
    margin-bottom: 24px;
    font-weight: 600;
    background: linear-gradient(
      90deg,
      var(--accent-green) 0%,
      var(--accent-purple) 50%,
      var(--accent-red) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .tagline {
    font: var(--md-sys-typescale-body-large);
    color: var(--text-secondary);
    max-width: 600px;
    margin-bottom: 32px;
    line-height: 1.6;
  }

  .about-bio {
    margin-bottom: 28px;
    max-width: 620px;
  }

  .about-bio p {
    font: var(--md-sys-typescale-body-medium);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 14px;
  }

  .about-bio p strong {
    color: var(--text-primary);
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .btn {
    padding: 12px 24px;
    border-radius: var(--md-sys-shape-lg);
    font: var(--md-sys-typescale-label-large);
    transition: var(--transition);
    cursor: pointer;
  }

  .btn-primary {
    background-color: var(--accent-green);
    color: var(--bg-color);
    box-shadow: 0 10px 30px -10px rgba(107, 227, 169, 0.4);
  }

  .btn-primary:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -10px rgba(107, 227, 169, 0.6);
  }

  .socials {
    display: flex;
    gap: 24px;
  }

  .socials a {
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 1rem;
    position: relative;
    padding: 5px 0;
  }

  .socials a::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--accent-green);
    transition: var(--transition);
  }

  .socials a:hover {
    color: var(--text-primary);
  }

  .socials a:hover::after {
    width: 100%;
  }

  .hero-highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 32px;
    max-width: 640px;
  }

  .hero-highlights .highlight {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--md-sys-color-surface-container);
    padding: 14px 16px;
    border-radius: var(--md-sys-shape-lg);
    border: 1px solid var(--md-sys-color-outline-variant);
    transition: var(--transition);
    text-align: left;
  }

  .hero-highlights .highlight:hover {
    background: var(--md-sys-color-surface-container-high);
    border-color: var(--accent-green);
    transform: translateY(-4px);
  }

  .hero-highlights .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: var(--md-sys-shape-sm);
    background: var(--md-sys-color-surface-container-high);
    color: var(--accent-green);
  }

  .hero-highlights .icon svg {
    width: 16px;
    height: 16px;
  }

  .highlight-text strong {
    display: block;
    font: var(--md-sys-typescale-title-small);
    color: var(--text-primary);
    margin-bottom: 1px;
  }

  .highlight-text p {
    font: var(--md-sys-typescale-body-small);
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.35;
  }

  .highlight-text .edu-link {
    display: inline-block;
    margin-top: 3px;
    font: var(--md-sys-typescale-label-medium);
    font-weight: 600;
    color: var(--accent-green);
  }

  .highlight-text .edu-link:hover {
    text-decoration: underline;
  }

  .hero-image {
    flex: 0 0 280px;
  }

  .profile-card {
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-xl);
    padding: 16px;
    box-shadow: var(--md-sys-elevation-2);
    transition: var(--transition);
  }

  .profile-card:hover {
    box-shadow: var(--md-sys-elevation-4);
    transform: translateY(-4px);
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    position: relative;
    z-index: 2;
    border: 3px solid var(--accent-green);
    box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.5), 0 0 30px rgba(107, 227, 169, 0.2);
    transition: var(--transition);
    animation: imagePulse 3s ease-in-out infinite;
  }

  .image-wrapper img:hover {
    transform: scale(1.03);
    box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.5), 0 0 40px rgba(107, 227, 169, 0.4);
  }

  .profile-card-footer {
    text-align: center;
    padding: 14px 4px 4px;
  }

  .profile-card-footer strong {
    display: block;
    font-family: var(--md-ref-typeface-brand);
    font: var(--md-sys-typescale-title-medium);
    font-weight: 700;
    color: var(--text-primary);
  }

  .profile-card-footer span {
    display: block;
    margin-top: 2px;
    font: var(--md-sys-typescale-body-medium);
    color: var(--accent-green);
    font-weight: 500;
  }

  @keyframes imagePulse {
    0%, 100% {
      box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.5), 0 0 30px rgba(107, 227, 169, 0.2);
    }
    50% {
      box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.5), 0 0 50px rgba(107, 227, 169, 0.35);
    }
  }

  .image-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(
      circle,
      rgba(107, 227, 169, 0.15) 0%,
      transparent 70%
    );
    z-index: 1;
    pointer-events: none;
    animation: glowPulse 3s ease-in-out infinite;
  }

  @keyframes glowPulse {
    0%, 100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }

  @media (max-width: 1024px) {
    .hero-content {
      flex-direction: column-reverse;
      text-align: center;
      gap: 32px;
    }

    .hero-subtitle {
      text-align: center;
    }
    .hero-actions {
      justify-content: center;
      flex-direction: column;
      gap: 20px;
    }
    .hero-image {
      flex: 0 0 260px;
      width: 260px;
    }
    .hero-title {
      font: var(--md-sys-typescale-headline-large);
    }
    .tagline {
      margin: 0 auto 40px;
    }
    .hero-highlights {
      margin: 32px auto 0;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 120px;
    }
    .hero-highlights {
      grid-template-columns: 1fr;
      max-width: 360px;
    }
    .hero-highlights .highlight {
      justify-content: flex-start;
    }
  }
</style>
