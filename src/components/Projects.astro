---
const projects = [
  {
    name: {
      es: "Bot de WhatsApp - Sistema de Turnos",
      en: "WhatsApp Bot - Appointment System",
    },
    description: {
      es: "Bot de WhatsApp que gestiona los turnos de una barbería, brindando disponibilidad 24/7. Permite agendar, cancelar y consultar turnos de forma automatizada.",
      en: "WhatsApp bot that manages barbershop appointments, providing 24/7 availability. Allows scheduling, canceling and querying appointments automatically.",
    },
    techStack: ["Python", "FastAPI", "WhatsApp API TWILIO", "PostgreSQL"],
    repo: "https://github.com/FernandezMarcodev/whatsapp-bot",
    img: "/assets/images/project-barberbot.jpeg",
    docs: "/assets/docs/barber-bot-docs.pdf",
  },
  {
    name: {
      es: "Carritos Abandonados - Tienda Nube",
      en: "Abandoned Carts - Tienda Nube",
    },
    description: {
      es: "Sistema que guarda los carritos abandonados y envía notificaciones a los usuarios. Consume la API de Tienda Nube para sincronizar productos y recuperar ventas.",
      en: "System that saves abandoned carts and sends notifications to users. Consumes the Tienda Nube API to sync products and recover sales.",
    },
    techStack: ["Python", "FastAPI", "Tienda Nube API", "PostgreSQL"],
    repo: "https://github.com/FernandezMarcodev/Abandoned-Carts",
    img: "/assets/images/project-abandonedcarts.jpeg",
    docs: "/assets/docs/abandoned-carts-docs.pdf",
  },
];
---

<section id="projects" class="projects-section reveal">
  <div class="projects-header">
    <h2 data-es="Proyectos Destacados" data-en="Featured Projects">
      Proyectos Destacados
    </h2>
    <p
      data-es="Una selección de trabajos que demuestran mis habilidades en desarrollo y calidad."
      data-en="A selection of works that demonstrate my development and quality skills."
    >
      Una selección de trabajos que demuestran mis habilidades en desarrollo y
      calidad.
    </p>
  </div>

  <div class="projects-grid">
    {
      projects.map((project) => (
        <div class="project-card">
          <div class="project-image">
            <img src={project.img} alt={project.name.es} loading="lazy" />
          </div>
          <div class="project-info">
            <div class="project-buttons">
              <a
                href={project.repo}
                target="_blank"
                class="btn-repo"
                data-es="Link al repositorio"
                data-en="Link to repository"
              >
                Link al repositorio
              </a>
              <a
                href={project.docs}
                target="_blank"
                class="btn-docs"
                data-es="Ver documentación"
                data-en="View documentation"
              >
                Ver documentación
              </a>
            </div>
            <div class="project-tags">
              {project.techStack.map((tech) => (
                <span class="tag">{tech}</span>
              ))}
            </div>
            <h3 data-es={project.name.es} data-en={project.name.en}>
              {project.name.es}
            </h3>
            <p
              data-es={project.description.es}
              data-en={project.description.en}
            >
              {project.description.es}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .projects-section {
    padding: 80px 0 160px;
    max-width: 960px;
  }

  .projects-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .projects-header p {
    color: var(--text-secondary);
    font: var(--md-sys-typescale-body-large);
    max-width: 600px;
    margin: 0 auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(400px, 100%), 1fr));
    gap: 32px;
  }

  .project-card {
    background: var(--md-sys-color-surface-container);
    border-radius: var(--md-sys-shape-xl);
    overflow: hidden;
    border: 1px solid var(--md-sys-color-outline-variant);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
    box-shadow: var(--md-sys-elevation-1);
  }

  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--md-sys-elevation-4);
    border-color: var(--accent-green);
  }

  .project-image {
    position: relative;
    height: 250px;
    overflow: hidden;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .project-card:hover .project-image img {
    transform: scale(1.08);
  }

  .project-buttons {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .btn-repo,
  .btn-docs {
    padding: 12px 20px;
    border-radius: var(--md-sys-shape-lg);
    font: var(--md-sys-typescale-label-large);
    transition: var(--transition);
    text-align: center;
    flex: 1;
    min-width: 140px;
  }

  .btn-repo {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }

  .btn-repo:hover {
    transform: translateY(-2px);
    box-shadow: var(--md-sys-elevation-2);
  }

  .btn-docs {
    background: var(--md-sys-color-surface-container-high);
    color: var(--text-primary);
    border: 1px solid var(--md-sys-color-outline-variant);
  }

  .btn-docs:hover {
    background: var(--md-sys-color-surface-container-highest);
    border-color: var(--accent-green);
    transform: translateY(-2px);
  }

  .project-info {
    padding: 28px;
    flex: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .tag {
    font: var(--md-sys-typescale-label-medium);
    background: var(--md-sys-color-surface-container-high);
    color: var(--accent-green);
    padding: 6px 12px;
    border-radius: var(--md-sys-shape-sm);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .project-info h3 {
    font: var(--md-sys-typescale-headline-small);
    margin-bottom: 12px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .project-info p {
    color: var(--text-secondary);
    font: var(--md-sys-typescale-body-medium);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .projects-section {
      padding: 56px 0 96px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .projects-header {
      margin-bottom: 40px;
    }
  }

  @media (max-width: 480px) {
    .projects-section {
      padding: 48px 0 80px;
    }

    .project-info {
      padding: 20px 16px;
    }

    .project-image {
      height: 200px;
    }

    .btn-repo,
    .btn-docs {
      min-width: 100%;
    }
  }
</style>
